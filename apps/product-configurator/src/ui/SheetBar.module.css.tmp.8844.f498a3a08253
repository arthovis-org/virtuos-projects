/* The phone sheet's bar; on larger screens the panel is always open and this is hidden. */
.bar {
  position: relative;
  display: none;
  align-items: center;
  gap: 0.5rem;
  width: 100%;
  padding: 1rem 1rem 0.75rem;
  border: 0;
  background: transparent;
  text-align: left;
}

.handle {
  position: absolute;
  top: 0.4375rem;
  left: 50%;
  width: 2.5rem;
  height: 4px;
  border-radius: 2px;
  background: var(--border-strong);
  transform: translateX(-50%);
}

.title {
  min-width: 0;
  overflow: hidden;
  font-size: 0.9375rem;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail {
  flex-shrink: 0;
  font-size: 0.8125rem;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
}

.action {
  flex-shrink: 0;
  margin-left: auto;
  padding: 0.375rem 0.875rem;
  border-radius: var(--radius-pill);
  background: var(--accent);
  color: var(--accent-contrast);
  font-size: 0.8125rem;
  font-weight: 600;
}

@media (max-width: 900px) {
  .bar {
    display: flex;
  }
}
